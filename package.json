{
  "name": "pokedex-desktop",
  "version": "0.1.1",
  "private": true,
  "author": "Pokedex Desktop",
  "description": "离线中文宝可梦图鉴 · Windows 桌面版",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "data:import": "python scripts/import_data.py",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@smogon/calc": "0.12.0",
    "cheerio": "1.2.0",
    "lucide-react": "^1.55.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
